Dim ws As Worksheet
Dim startRow As Long, endRow As Long

Set ws = TEMP   ' 또는 Set ws = Worksheets("시트명") 로 명확히

If InStr(1, UCase$(ws.Cells(x, "A").Value), "TRADER PL") > 0 Then
    
    ' endRow: A99에서 위로 올라간 마지막 데이터 행
    endRow = ws.Range("A99").End(xlUp).Row
    
    ' startRow: x행 기준으로 위쪽 마지막 데이터의 다음 행
    startRow = ws.Cells(x, "A").End(xlUp).Row + 1
    
    ' 삭제 범위 유효성 체크
    If startRow <= endRow Then
        ws.Rows(startRow & ":" & endRow).Delete
    End If

End If
